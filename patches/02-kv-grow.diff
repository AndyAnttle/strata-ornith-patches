+// ---- --kv-grow: the KV's address range reserved once, its pages mapped as far as the context reaches ----------------
+// A KV buffer is indexed (head * ctx + pos) * cell, so its address range must cover the whole --max-context; a plain
+// cudaMalloc therefore also commits the whole context's memory at load, which on a 12-24 GB card is memory the expert
+// cache needs for a conversation that may never reach it.  CUDA's virtual memory keeps the range and lets the pages
+// arrive later: on the owner's box a 4 GiB reservation cost 0 MiB of free memory, each 256 MiB mapping cost exactly
+// that, un-mapping gave it back, and the range read back bit-exact.
+struct KvRes {
+    CUdeviceptr va = 0;          // the whole range (max-context cells per head); valid from the first mapping on
+    size_t bytes = 0;            // that range's size
+    size_t cell = 0;             // bytes per cell
+    int heads = 1;               // KV heads: the layout is (head * ctx + pos) * cell, so each head is its own span
+    size_t head_cells = 0;       // ctx, the cells one head holds
+    std::vector<size_t> mapped;  // per head: bytes mapped from its granularity-aligned span start
+};
+#if !defined(__HIP_PLATFORM_AMD__)
+inline CUmemAllocationProp kv_prop(int dev) {
+    CUmemAllocationProp p{};
+    p.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+    p.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    p.location.id = dev;
+    p.requestedHandleTypes = CU_MEM_HANDLE_TYPE_NONE;
+    return p;
+}
+inline size_t kv_granularity(int dev) {
+    size_t g = 0;
+    CUmemAllocationProp p = kv_prop(dev);
+    if (cuMemGetAllocationGranularity(&g, &p, CU_MEM_ALLOC_GRANULARITY_MINIMUM) != CUDA_SUCCESS || g == 0)
+        return (size_t) 2 << 20;
+    return g;
+}
+inline bool kv_vmm_supported(int dev) {
+    int v = 0;
+    return cuDeviceGetAttribute(&v, CU_DEVICE_ATTRIBUTE_VIRTUAL_ADDRESS_MANAGEMENT_SUPPORTED, dev) == CUDA_SUCCESS && v != 0;
+}
+/// Reserve the address range of `heads` x `head_cells` cells; nothing is backed yet, so this costs no device memory.
+inline bool kv_reserve(KvRes& r, int heads, size_t head_cells, size_t cell, int dev, std::string& err) {
+    const size_t g = kv_granularity(dev);
+    const size_t bytes = (size_t) heads * head_cells * cell;
+    const size_t want = (bytes + g - 1) / g * g;
+    if (cuMemAddressReserve(&r.va, want, g, 0, 0) != CUDA_SUCCESS) {
+        err = "cuMemAddressReserve failed for " + std::to_string(want >> 20) + " MiB";
+        return false;
+    }
+    r.bytes = want;
+    r.cell = cell;
+    r.heads = heads;
+    r.head_cells = head_cells;
+    r.mapped.assign((size_t) heads, 0);
+    return true;
+}
+/// Map, per head, the first `cells` cells: the layout puts head h at h * head_cells * cell, so one contiguous prefix
+/// would back head 0 only and the attention kernels would read uncommitted addresses of the others.  Each head's span
+/// start is rounded DOWN to the granularity and its mapped length is tracked, so a growth step maps the new tail only.
+/// New pages are zeroed: a shorter prompt never writes cells the attention path still reads.
+inline bool kv_commit_to(KvRes& r, size_t cells, int dev, std::string& err) {
+    if (r.va == 0) return true;
+    const size_t g = kv_granularity(dev);
+    const size_t want = std::min(cells, r.head_cells) * r.cell;
+    if (want == 0) return true;
+    CUmemAllocationProp p = kv_prop(dev);
+    CUmemAccessDesc ad{};
+    ad.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+    ad.location.id = dev;
+    ad.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+    for (int h = 0; h < r.heads; ++h) {
+        const size_t span = (size_t) h * r.head_cells * r.cell;     // this head's offset in the buffer
+        const size_t base = span & ~(g - 1);                        // cuMemMap wants a granularity-aligned address
+        const size_t need = (span - base) + want;                   // what this head must have mapped, from base
+        const size_t target = (need + g - 1) / g * g;
+        size_t& have = r.mapped[(size_t) h];
+        while (have < target) {
+            size_t step = std::min(target - have, (size_t) 256 << 20);
+            step = (step + g - 1) / g * g;
+            // A mapping the card cannot really hold is what Windows answers by moving memory to shared memory, and the
+            // desktop then crawls at 99% 3D: refuse instead, before the driver can decide for us.
+            size_t fr = 0, tot = 0;
+            (void) cudaMemGetInfo(&fr, &tot);
+            // the first mapping has to leave the card its reserve; later ones grow in 2 MiB steps and are limited by
+            // the expert cache giving memory back, so a big margin here would evict a layer per granule
+            const size_t floor_b = have == 0 ? ((size_t) 256 << 20) : ((size_t) 64 << 20);
+            if (fr < step + floor_b) {
+                err = "only " + std::to_string(fr >> 20) + " MiB free, " + std::to_string(step >> 20) +
+                      " MiB needed plus a 256 MiB floor (at " + std::to_string(cells) + " cells)";
+                return false;
+            }
+            CUmemGenericAllocationHandle hh = 0;
+            if (cuMemCreate(&hh, step, &p, 0) != CUDA_SUCCESS) {
+                err = "out of device memory mapping " + std::to_string(step >> 20) + " MiB of KV (head " +
+                      std::to_string(h) + " at " + std::to_string(cells) + " cells)";
+                return false;
+            }
+            const CUdeviceptr at = r.va + base + have;
+            CUresult mr = cuMemMap(at, step, 0, hh, 0);
+            if (mr == CUDA_ERROR_INVALID_VALUE) {
+                // the address is still mapped somewhere: take it back and try once
+                (void) cuMemUnmap(at, step);
+                mr = cuMemMap(at, step, 0, hh, 0);
+            }
+            if (mr != CUDA_SUCCESS) {
+                size_t fr2 = 0, tot2 = 0;
+                (void) cudaMemGetInfo(&fr2, &tot2);
+                std::fprintf(stderr,
+                             "strata-q36: --kv-grow: cuMemMap at %zu (head %d, step %zu, have %zu) -> %d, free %zu MiB\n",
+                             (size_t) at, h, step, have, (int) mr, fr2 >> 20);
+                (void) cuMemRelease(hh);
+                err = "cuMemMap failed (head " + std::to_string(h) + ")";
+                return false;
+            }
+            (void) cuMemRelease(hh);
+            if (cuMemSetAccess(at, step, &ad, 1) != CUDA_SUCCESS) {
+                (void) cuMemUnmap(at, step);
+                err = "cuMemSetAccess failed";
+                return false;
+            }
+            if (cudaMemset((void*) at, 0, step) != cudaSuccess) {
+                err = "zeroing the new KV pages failed";
+                return false;
+            }
+            have += step;
+        }
+    }
+    return true;
+}
+/// --kv-grow: unmap the KV's pages past `cells`, so a request that needs little context can hand the memory back
+/// to the expert cache.  The layout is (head * ctx + pos) * cell: every head keeps its own granular span.
+inline void kv_shrink_to(KvRes& r, int64_t cells, int dev) {
+    if (r.va == 0 || r.heads <= 0) return;
+    const size_t g = kv_granularity(dev);
+    const size_t want_cells = (size_t) std::max<int64_t>(0, std::min<int64_t>(cells, (int64_t) r.head_cells));
+    const size_t want = ((want_cells * r.cell) + g - 1) / g * g;
+    for (int h = 0; h < r.heads; ++h) {
+        const size_t span = (size_t) h * r.head_cells * r.cell;
+        const size_t base = span & ~(g - 1);
+        while ((size_t) h < r.mapped.size() && r.mapped[(size_t) h] > want) {
+            const size_t step = std::min(r.mapped[(size_t) h] - want, g * 16);
+            if (cuMemUnmap(r.va + base + r.mapped[(size_t) h] - step, step) != CUDA_SUCCESS) break;
+            r.mapped[(size_t) h] -= step;
+        }
+    }
+}
+
+inline void kv_release(KvRes& r, int dev) {
+    if (r.va == 0) return;
+    const size_t g = kv_granularity(dev);
+    for (int h = 0; h < r.heads; ++h) {
+        const size_t span = (size_t) h * r.head_cells * r.cell;
+        const size_t base = span & ~(g - 1);
+        if (r.mapped[(size_t) h] > 0) (void) cuMemUnmap(r.va + base, r.mapped[(size_t) h]);
+    }
+    (void) cuMemAddressFree(r.va, r.bytes);
+    r = KvRes{};
+}
+#else
+inline bool kv_vmm_supported(int) { return false; }
+inline bool kv_reserve(KvRes&, int, size_t, size_t, int, std::string& err) { err = "not built for CUDA"; return false; }
+inline bool kv_commit_to(KvRes&, size_t, int, std::string&) { return true; }
+inline void kv_release(KvRes& r, int) { r = KvRes{}; }
+#endif
