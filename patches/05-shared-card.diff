 // ------------------------------------------------------------------------------------------------ expert placement
+/// Is another program driving a display on this card?  Windows keeps the desktop's composition surfaces there even
+/// when nothing looks busy, and nvidia-smi lists those processes as "C+G"; the CUDA free-memory reading alone cannot
+/// tell such a card from a dedicated one (measured: a 12 GB card that drove its display reported 1.1 GiB in use at
+/// start, because the desktop itself holds little until a window is opened).  NVML is loaded at run time so the build
+/// needs no new library; a machine without it answers false and the caller falls back to the free-memory reading.
+static bool card_has_display_processes() {
+#if defined(_WIN32)
+    HMODULE lib = LoadLibraryA("nvml.dll");
+#else
+    void* lib = dlopen("libnvidia-ml.so.1", RTLD_NOW);
+#endif
+    if (lib == nullptr) return false;
+    using Init = int (*)();
+    using Shutdown = int (*)();
+    using ByPci = int (*)(const char*, void**);
+    using Graphics = int (*)(void*, void**, unsigned int*);
+    using Count = int (*)(void*, unsigned int*);
+#if defined(_WIN32)
+#define Q36_SYM(x) GetProcAddress(lib, x)
+#else
+#define Q36_SYM(x) dlsym(lib, x)
+#endif
+    auto init = (Init) Q36_SYM("nvmlInit_v2");
+    auto fini = (Shutdown) Q36_SYM("nvmlShutdown");
+    auto by_pci = (ByPci) Q36_SYM("nvmlDeviceGetHandleByPciBusId_v2");
+    auto graphics = (Graphics) Q36_SYM("nvmlDeviceGetGraphicsRunningProcesses_v2");
+    auto count = (Count) Q36_SYM("nvmlDeviceGetGraphicsRunningProcessesCount_v2");
+    char pci[64] = {};
+    bool has = false;
+    if (init && fini && by_pci && (graphics || count) && cudaDeviceGetPCIBusId(pci, sizeof pci, 0) == cudaSuccess) {
+        if (init() == 0) {
+            void* dev = nullptr;
+            if (by_pci(pci, &dev) == 0 && dev != nullptr) {
+                // Ask for the count with an empty buffer: NVML answers 0 and leaves the value alone when there is
+                // none, and INSUFFICIENT_SIZE (8) with the real count when there are some (measured: a compute 3090
+                // returned 0 while the caller's 32 stayed, which read as "32 display processes").
+                if (count) {
+                    unsigned int n = 0;
+                    const int rc = count(dev, &n);
+                    if ((rc == 0 || rc == 8) && n > 0) has = true;
+                } else {
+                    unsigned int n = 0;
+                    const int rc = graphics(dev, nullptr, &n);
+                    if ((rc == 0 || rc == 8) && n > 0) has = true;
+                }
+            }
+            (void) fini();
+        }
+    }
+#undef Q36_SYM
+#if defined(_WIN32)
+    FreeLibrary(lib);
+#else
+    dlclose(lib);
+#endif
+    return has;
+}
