+__global__ void store_v4(const float* x, q36attn::q4_cell* out) {
+    __shared__ float sh[256];
+    q36attn::kv4_store(reinterpret_cast<uint8_t*>(out + blockIdx.x), threadIdx.x, x[(size_t) blockIdx.x * 256 + threadIdx.x], sh);
